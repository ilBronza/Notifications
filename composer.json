{
    "name": "ilbronza/notifications",
    "description": "Database notifications, shared management and private voice messages for Laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide@sistema.srl",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/notifications",
    "keywords": [
        "Laravel",
        "Notifications"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.48 || ^11.0 || ^12.0",
        "ilbronza/crud": "*",
        "ilbronza/accountmanager": "*",
        "ilbronza/datatables": "*",
        "ilbronza/form": "*",
        "ilbronza/formfield": "*",
        "ilbronza/buttons": "*",
        "ilbronza/menu": "*",
        "ilbronza/uikittemplate": "*",
        "ilbronza/ukn": "*",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-permission": "^5.11 || ^6.0",
        "spatie/laravel-medialibrary": "^10.13 || ^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Notifications\\Tests\\": "tests",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Notifications\\NotificationsServiceProvider"
            ],
            "aliases": {
                "Notifications": "IlBronza\\Notifications\\Facades\\Notifications"
            }
        }
    },
    "suggest": {
        "laravel/slack-notification-channel": "Required only when using SlackNotification."
    },
    "scripts": {
        "test": "phpunit",
        "test:lint": "@php tests/lint.php"
    }
}
